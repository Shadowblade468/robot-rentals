# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Path to your Google OAuth2 credentials JSON (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_PATH=credentials.json

# Path where the agent stores the OAuth token after first login
GMAIL_TOKEN_PATH=token.json

# How often to check for new emails (seconds). Default: 300 (5 minutes)
CHECK_INTERVAL_SECONDS=300
